{
  "expo": {
    "scheme": "pharmadali",
    "name": "PharmaDali",
    "slug": "mobile",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/9dc21ec8-6add-4b56-a96a-85d7d3fddfa3",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/app_icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/app_icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/app_icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.pharmadali.customer",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/app_icon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/app_icon.png",
          "color": "#48AAD9"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9dc21ec8-6add-4b56-a96a-85d7d3fddfa3"
      },
      "appType": "customer"
    },
    "owner": "gitofjames"
  }
}
