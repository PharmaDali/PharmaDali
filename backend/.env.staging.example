# ==============================================================================
# PharmaDali — Laravel Staging Environment Configuration
# ==============================================================================
# Copy this file to backend/.env inside your /var/www/pharmadali-staging/backend directory:
#   cp backend/.env.staging.example backend/.env
# ==============================================================================

APP_NAME="PharmaDali (Staging)"
APP_ENV=staging
APP_KEY=
APP_DEBUG=true
APP_URL=https://staging-api.yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ------------------------------------------------------------------ #
# Database (Connects to shared MySQL via Docker app-network)         #
# ------------------------------------------------------------------ #
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=pharmadali_staging
DB_USERNAME=pharmadali_staging
DB_PASSWORD=StagingStrongPassword2026!

# ------------------------------------------------------------------ #
# Redis Cache, Sessions & Queues (Isolated with DB index 1 & prefix) #
# ------------------------------------------------------------------ #
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=1
REDIS_CACHE_DB=1
REDIS_PREFIX=pharmadali_staging_database_

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=staging_cache_

# ------------------------------------------------------------------ #
# Laravel Reverb (WebSockets for Staging)                            #
# ------------------------------------------------------------------ #
BROADCAST_CONNECTION=reverb

REVERB_SERVER=reverb
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_SERVER_PATH=

REVERB_HOST=staging-ws.yourdomain.com
REVERB_PORT=443
REVERB_SCHEME=https

REVERB_APP_ID=pharmadali_staging_app
REVERB_APP_KEY=staging_key_capstone_2026
REVERB_APP_SECRET=staging_secret_capstone_2026

REVERB_ALLOWED_ORIGINS=*
CORS_ALLOWED_ORIGINS=*

# ------------------------------------------------------------------ #
# Sanctum & Frontend URLs                                            #
# ------------------------------------------------------------------ #
SANCTUM_STATEFUL_DOMAINS=staging-admin.yourdomain.com
FRONTEND_URL=https://staging-admin.yourdomain.com

# ------------------------------------------------------------------ #
# Search Index (Meilisearch with isolated staging_ prefix)           #
# ------------------------------------------------------------------ #
SCOUT_DRIVER=meilisearch
SCOUT_PREFIX=staging_
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=pharmadali_master_key

# ------------------------------------------------------------------ #
# Filesystem Storage                                                 #
# ------------------------------------------------------------------ #
FILESYSTEM_DISK=local

# ------------------------------------------------------------------ #
# Demo Super Admin Seed Credentials (for Capstone Defense)           #
# ------------------------------------------------------------------ #
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin
SUPER_ADMIN_EMAIL=superadmin@gmail.com
SUPER_ADMIN_PASSWORD=superadminpassword
SUPER_ADMIN_MOBILE=000000000000

# ------------------------------------------------------------------ #
# Mailer (Set to 'log' so no real emails are sent during demo)        #
# ------------------------------------------------------------------ #
MAIL_MAILER=log
MAIL_FROM_ADDRESS="staging@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Optional AI / Gemini settings
GOOGLE_GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
