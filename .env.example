# PharmaDali Docker Deployment — Environment Variables
# Copy this to .env and fill in your production values.
# This file configures docker-compose.yml (domains, proxy, database credentials).
# Application-level configuration belongs in backend/.env

# -------------------------------------------------------------------
# Domain Configuration
# -------------------------------------------------------------------
BACKEND_DOMAIN=api.yourdomain.com
ADMIN_DOMAIN=admin.yourdomain.com
REVERB_DOMAIN=ws.yourdomain.com

# Email used by Let's Encrypt for SSL certificate notifications
LETSENCRYPT_EMAIL=admin@yourdomain.com

# -------------------------------------------------------------------
# MySQL Credentials
# These are used to initialise the MySQL container.
# Mirror DB_DATABASE, DB_USERNAME, DB_PASSWORD inside backend/.env
# -------------------------------------------------------------------
DB_ROOT_PASSWORD=change-this-strong-root-password
DB_DATABASE=pharmadali
DB_USERNAME=pharmadali_user
DB_PASSWORD=change-this-strong-db-password
