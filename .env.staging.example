# ==============================================================================
# PharmaDali — Staging Root Environment Configuration
# ==============================================================================
# Copy this file to .env inside your /var/www/pharmadali-staging directory:
#   cp .env.staging.example .env
# ==============================================================================

COMPOSE_PROJECT_NAME=pharmadali-staging

# ------------------------------------------------------------------ #
# Staging Subdomain Configuration                                    #
# ------------------------------------------------------------------ #
# Replace 'yourdomain.com' with your actual registered domain name
BACKEND_DOMAIN=staging-api.yourdomain.com
ADMIN_DOMAIN=staging-admin.yourdomain.com
REVERB_DOMAIN=staging-ws.yourdomain.com

# Email used by Let's Encrypt for automatic SSL certificate generation
LETSENCRYPT_EMAIL=your_email@example.com

# ------------------------------------------------------------------ #
# Staging MySQL Database Credentials                                 #
# ------------------------------------------------------------------ #
# Isolated database created specifically for staging and capstone defense
DB_DATABASE=pharmadali_staging
DB_USERNAME=pharmadali_staging
DB_PASSWORD=StagingStrongPassword2026!

# ------------------------------------------------------------------ #
# Laravel Reverb (WebSockets) Credentials for Staging                #
# ------------------------------------------------------------------ #
REVERB_APP_ID=pharmadali_staging_app
REVERB_APP_KEY=staging_key_capstone_2026
REVERB_APP_SECRET=staging_secret_capstone_2026

# Shared Meilisearch master key
MEILISEARCH_KEY=pharmadali_master_key
